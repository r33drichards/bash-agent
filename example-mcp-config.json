{
  "mcpServers": {
    "playwright": {
      "command": "mcp-server-playwright",
      "args": [
        "--headless"
      ]
    },
    "sequentialthinking": {
      "command": "mcp-server-sequential-thinking"
    },
    "memory": {
      "command": "mcp-server-memory"
    },
    "git-rag": {
      "command": "mcp-server-git-rag",
      "env": {
        "OPENAI_API_KEY": "your-openai-api-key-here",
        "GIT_RAG_PERSIST_DIR": "./git_rag_storage"
      }
    }
  }
}